rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /checkIns/{checkInId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    match /spotCounts/{spotId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /sessions/{sessionId} {
      allow read, write: if request.auth != null && (
        resource == null || resource.data.userId == request.auth.uid
      );
    }
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Friend requests/lists/search all need to display OTHER users'
      // usernames (e.g. "who sent this request", "what's my friend's
      // handle") — firestoreGetUserProfile reads an arbitrary userId for
      // exactly this. A single-document get (not a query/list) of someone
      // else's doc, scoped to any signed-in user.
      // NOTE: this currently exposes the WHOLE users doc (friendIds +
      // username) to any signed-in user, not just username. friendIds
      // being visible isn't a meaningful leak in this app today, but if
      // more sensitive fields are ever added to this doc, split username
      // into its own public sub-document/collection instead of widening
      // this further.
      allow get: if request.auth != null;

      // Friend accept/decline/remove needs to write `friendIds` into the
      // OTHER user's doc (not just your own). This narrow exception allows
      // that single field to change on someone else's doc, but nothing else:
      // every other field must be untouched, and the writer must be either
      // adding or removing exactly themself from the array (can't add/remove
      // arbitrary other userIds on someone else's behalf).
      allow update: if request.auth != null
        && request.auth.uid != userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friendIds'])
        && (
          // Adding self: new list = old list + [auth.uid], nothing removed
          (request.resource.data.friendIds.size() == resource.data.get('friendIds', []).size() + 1
            && request.auth.uid in request.resource.data.friendIds
            && resource.data.get('friendIds', []).toSet().difference(request.resource.data.friendIds.toSet()).size() == 0)
          ||
          // Removing self: new list = old list - [auth.uid], nothing added
          (request.resource.data.friendIds.size() == resource.data.get('friendIds', []).size() - 1
            && !(request.auth.uid in request.resource.data.friendIds)
            && request.resource.data.friendIds.toSet().difference(resource.data.get('friendIds', []).toSet()).size() == 0)
        );
    }
    match /usernames/{usernameKey} {
      // Anyone signed in can check availability / look up a userId by username.
      allow read: if request.auth != null;

      // Claiming a username: must point the doc at yourself.
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;

      // Releasing your own old username when you change it. Must tolerate
      // deleting a username doc that was never actually created — the app
      // may pass a "previous username" derived from a displayName fallback
      // that was never claimed via firestoreSetUsername. Accessing
      // resource.data on a nonexistent doc errors (which Firestore treats
      // as a denial), so check existence first via resource != null.
      allow delete: if request.auth != null
        && (resource == null || resource.data.userId == request.auth.uid);

      // Re-setting a username you already own (e.g. re-saving the same
      // profile) is an update, not a create — allow it only if the doc
      // already points to you and still does after the write.
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }
    match /friendRequests/{requestId} {
      // Single-document fetch by ID: either party can read it directly.
      // (get operations check actual resource.data, so the OR is fine here.)
      allow get: if request.auth != null
        && (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);

      // Queries (list): Firestore verifies list rules against the query's
      // potential result set, not actual document data. An OR across two
      // different fields can't be proven unless the query itself constrains
      // both — so each real query needs its own rule matching what it
      // actually filters on, not a combined OR.
      //   - firestoreGetIncomingFriendRequests filters where('toUserId','==',self)
      //   - firestoreGetFriendRequestBetween runs two queries, one filtering
      //     where('fromUserId','==',self), one filtering where('toUserId','==',self)
      allow list: if request.auth != null
        && resource.data.toUserId == request.auth.uid;
      allow list: if request.auth != null
        && resource.data.fromUserId == request.auth.uid;

      // Only the sender can create a request, and only as themself.
      allow create: if request.auth != null
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.toUserId != request.auth.uid
        && request.resource.data.status == 'pending';

      // Only the recipient can accept/decline; only the status field moves.
      allow update: if request.auth != null
        && resource.data.toUserId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['accepted', 'declined'];

      allow delete: if false;
    }
    match /spots/{spotId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /spotPhotos/{spotId}/photos/{photoId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uploadedBy == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uploadedBy == request.auth.uid;
    }
    match /forecastFeedback/{feedbackId} {
      allow read: if false;
      allow create: if request.auth != null;
    }
  }
}
